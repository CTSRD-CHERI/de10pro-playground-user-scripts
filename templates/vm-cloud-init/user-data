#cloud-config

hostname: de10playground-vm

users:
  - name: de10-user
    uid: 1000
    homedir: /home/de10-user
    passwd: $6$123456789$vc6EMZXHdKg0l1EtbVYgrIzymDsDTzj1QscEa0rxCWQLnD0RQD4Y/9tNHNjz3OrSaKo3KNLD1UW5b7kcYhjNG1
    lock-passwd: false
    chpasswd: { expire: False }
    groups: sudo, admin, plugdev, dialout
    shell: /bin/bash
    ssh_authorized_keys:
    {% for keypair in ssh_keys -%}
      - {{ keypair["pub"] }}
    {%- endfor %}

packages:
  {% for pkg in packages -%}
  - {{ pkg }}
  {% endfor %}

write_files:
  - path: /opt/sourceme.sh
    permissions: '0644'
    content: |
      echo 'de10playground sourceme'

  - path: /opt/install_quartus_programmer.sh
    permissions: '0755'
    content: |
      #! /usr/bin/env sh

      echo "Downloading and installing quartus programmer"
      QUARTUS_TOOLS_INSTALLDIR="{{quartus_tools_install_dir}}"
      wget https://downloads.intel.com/akdlm/software/acdsinst/23.3/104/ib_installers/QuartusProProgrammerSetup-23.3.0.104-linux.run \
        -O /tmp/installer \
      && chmod +x /tmp/installer \
      && /tmp/installer --accept_eula 1 --mode unattended --installdir $QUARTUS_TOOLS_INSTALLDIR
      LIB_BASE=${QUARTUS_TOOLS_INSTALLDIR}/qprogrammer/quartus/linux64/libtinfo.so
      mv ${LIB_BASE}.6.4 ${LIB_BASE}.6.4.off
      mv ${LIB_BASE}.6 ${LIB_BASE}.6.off
      mv ${LIB_BASE} ${LIB_BASE}.off
      rm -f /tmp/installer
      echo "export PATH=\"${QUARTUS_TOOLS_INSTALLDIR}/qprogrammer/quartus/bin/:\${PATH}\"" >> /opt/sourceme.sh

  - path: /opt/install_openocd.sh
    permissions: '0755'
    content: |
      #! /usr/bin/env sh

      echo "Cloning, building and installing openocd"
      OPENOCD_INSTALLDIR="/opt/openocd"
      git clone --depth=1 --branch latest https://github.com/openocd-org/openocd.git /tmp/openocd \
      && cd /tmp/openocd \
      && git submodule update --init --recursive \
      && ./bootstrap \
      && ./configure --prefix=$OPENOCD_INSTALLDIR --enable-usb-blaster=yes --enable-internal-jimtcl=yes \
      && make -j4 \
      && make install
      rm -rf /tmp/openocd
      echo "export PATH=\"${OPENOCD_INSTALLDIR}/bin/:\${PATH}\"" >> /opt/sourceme.sh

  - path: /opt/gen_uboot_init_bootp_scr.sh
    permissions: '0755'
    content: |
      #! /usr/bin/env sh

      idx=$(jq '.box_slot_idx' /mnt/board_info/board_info.json)
      hex_idx=$(printf "%02x" "$idx")
      ethaddr="ee:ee:ee:ee:ee:$hex_idx"
      UBOOT_SCRIPT=$(mktemp /tmp/uboot_script.XXXX)
      cat <<EOF > "$UBOOT_SCRIPT"
      setenv ethaddr $ethaddr;
      bootp;
      source 0x2000000;
      EOF
      mkimage -T script -d "$UBOOT_SCRIPT" /opt/uboot-init-bootp.scr
      rm "$UBOOT_SCRIPT"

  #- path: /etc/cloud/cloud.cfg.d/99-custom-networking.cfg
  #  permissions: '0600'
  #  content: |
  #    network: {config: disabled}

  - path: /etc/netplan/custom-vm-config.yaml
    permissions: '0600'
    content: |
      network:
        ethernets:
          alleths:
            match:
              name: en*
            dhcp4: true

  - path: /etc/udev/rules.d/51-usbblaster.rules
    permissions: '0644'
    owner: root:root
    content: |
      # USB-Blaster
      SUBSYSTEM=="usb", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6001", MODE="0666", GROUP="plugdev"
      SUBSYSTEM=="usb", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6002", MODE="0666", GROUP="plugdev"
      SUBSYSTEM=="usb", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6003", MODE="0666", GROUP="plugdev"
      # USB-Blaster II
      SUBSYSTEM=="usb", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6010", MODE="0666", GROUP="plugdev"
      SUBSYSTEM=="usb", ATTR{idVendor}=="09fb", ATTR{idProduct}=="6810", MODE="0666", GROUP="plugdev"

  - path: /etc/udev/rules.d/52-usbuart.rules
    permissions: '0644'
    owner: root:root
    content: |
      # Microchip MCP2221 USB-I2C/UART Combo
      SUBSYSTEM=="usb", ATTR{idVendor}=="04d8", ATTR{idProduct}=="00dd", MODE="0666", GROUP="dialout"

