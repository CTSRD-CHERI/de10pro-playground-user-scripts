  - path: /etc/systemd/system/mnt-board_info.mount
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=DE10 board info mount
      ConditionPathExists=/dev/sdb

      [Mount]
      What=/dev/sdb
      Where=/mnt/board_info
      Options=ro,noatime,nofail

      [Install]
      WantedBy=multi-user.target de10playground-payload.service

  - path: /etc/systemd/system/home-de10\x2duser.mount
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=DE10 user disk
      ConditionPathExists=/dev/sdc1

      [Mount]
      What=/dev/sdc1
      Where=/home/de10-user
      Options=rw,noatime,nofail

      [Install]
      WantedBy=multi-user.target de10playground-payload.service

  # chown user home directory
  - path: /etc/systemd/system/home-de10\x2duser-fix-ownership.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Fix ownership of de10-user home folder
      After=home-de10\x2user.mount
      Requires=home-de10\x2duser.mount

      [Service]
      Type=oneshot
      ExecStart=/usr/bin/chown -R de10-user:de10-user /home/de10-user
      StandardOutput=journal+console

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/de10playground-payload.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Run de10 playground one shot payload script
      ConditionPathExists=/home/de10-user/de10playground-payload/runme.sh
      Requires=home-de10\x2duser.mount

      [Service]
      Type=oneshot
      ExecStart=/home/de10-user/de10playground-payload/runme.sh
      StandardOutput=journal+console

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/uboot-init-bootp-scr-create.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=Generate dynamic U-Boot script on boot
      Requires=mnt-board_info.mount
      After=local-fs.target

      [Service]
      Type=oneshot
      ExecStart=/opt/gen_uboot_init_bootp_scr.sh
      RemainAfterExit=true

      [Install]
      WantedBy=multi-user.target

  {% for keypair in ssh_keys -%}
  - path: /home/de10-user/.ssh/{{keypair["name"]}}
    permissions: '0600'
    owner: de10-user:de10-user
    content: "{{ keypair["priv"] }}"

  - path: /home/de10-user/.ssh/{{keypair["name"]}}.pub
    permissions: '0644'
    owner: de10-user:de10-user
    content: |
      {{ keypair["pub"] }}
  {%- endfor %}

